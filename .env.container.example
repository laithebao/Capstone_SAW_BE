# Docker --env-file format: do not wrap values in quotes.
# Run scripts/init-container.ps1 to generate .env.container.local and a random JWT key.
# This file is for local container verification, not production configuration.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Http__RedirectToHttps=false
ConnectionStrings__DefaultConnection=Server=host.docker.internal,1433;Database=SmartAgriWarehouseDB;User Id=REPLACE_SQL_USER;Password=REPLACE_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connect Timeout=5
Jwt__Key=REPLACE_WITH_A_RANDOM_JWT_KEY
Jwt__Issuer=saw-local-container
Jwt__Audience=saw-local-frontend
Cors__AllowedOrigins__0=http://localhost:5173
SupplierFiles__StoragePath=/app/App_Data/SupplierFiles
DeliveryRefusalFiles__StoragePath=/app/App_Data/DeliveryRefusalFiles
# External services stay disabled until their own configuration is supplied.
QrCode__Enabled=false
OpenAI__ApiKey=
Qdrant__Endpoint=
Qdrant__ApiKey=
AiChat__KnowledgeBaseAutoSync=false
# Only use Log for controlled local tests: verification/reset links contain tokens.
Email__DeliveryMode=Log
Smtp__EmailVerificationUrl=http://localhost:5173/verify-email
Smtp__PasswordResetUrl=http://localhost:5173/reset-password
