# Copy via: dotnet run --project tools/SAW.Testing -- init
# init generates a random local SQL password; never commit .env.test.local.
SAW_TEST_SQL_CONNECTION='Server=127.0.0.1,1434;Database=master;User Id=sa;Password=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD;Encrypt=False;TrustServerCertificate=True;Connect Timeout=30'
# Leave empty to discover Chrome/Edge on Windows, macOS or Linux.
EDGE_PATH=''
# Used only by --profile all. Use a separate Cloudinary test account/environment.
SAW_TEST_CLOUD_NAME=''
SAW_TEST_CLOUD_KEY=''
SAW_TEST_CLOUD_SECRET=''
